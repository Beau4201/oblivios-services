Subject: onion-tunnel: count the bytes of a flow per destination, so a scaffolding can tell a company that sends a lot

The tunnel adds the bytes of every flow to the counter that `get_bandwidth_counter` returns for the flow's isolation key,
which is one counter per app. The speed guard of the exit daemon (ADR-188) must tell what one company sends to one app, so
`get_flow_counter(isolation_key, tor_dst)` is asked in the Tor path instead, with the destination that the flow was opened
for. Its default calls `get_bandwidth_counter`, so a scaffolding that does not override it behaves as before. `on_rx` and
`on_tx` of the counter become public so that a scaffolding that keeps counters per destination can test its bookkeeping by
feeding one. A test pins the default.

--- a/crates/onion-tunnel/src/accounting.rs
+++ b/crates/onion-tunnel/src/accounting.rs
@@ -43,7 +43,9 @@ impl BandwidthCounter {
     }
 
     /// Increment the number of received bytes.
-    pub(crate) fn on_rx(&self, bytes: u64) {
+    /// Public since FreeholdOS patch 0006, so that a scaffolding that keeps one counter per destination can test its
+    /// bookkeeping by feeding the counter.
+    pub fn on_rx(&self, bytes: u64) {
         self.bytes_rx.fetch_add(bytes, Ordering::Relaxed);
     }
 
--- a/crates/onion-tunnel/src/proxy.rs
+++ b/crates/onion-tunnel/src/proxy.rs
@@ -296,7 +296,7 @@ where
         let (arti_r, arti_w) = arti_stream.split();
         let counter = self
             .scaffolding
-            .get_bandwidth_counter(self.isolation_key.app_id);
+            .get_flow_counter(self.isolation_key.app_id, &tor_addr);
         let arti_to_tun =
             InteractiveCopier::new(arti_r, self.socket.clone(), false, counter.clone());
         let tun_to_arti = InteractiveCopier::new(self.socket.clone(), arti_w, true, counter);
--- a/crates/onion-tunnel/src/scaffolding.rs
+++ b/crates/onion-tunnel/src/scaffolding.rs
@@ -343,6 +343,15 @@ pub trait TunnelScaffolding: Send + Sync + 'static {
         None
     }
 
+    /// The counter for one TCP flow through Tor, chosen by its isolation key and the destination it was asked for
+    /// (FreeholdOS patch 0006). The bytes that reach the app on this flow are added to the returned counter, so a
+    /// scaffolding can count per destination, not only per app. The default is [`Self::get_bandwidth_counter`], so
+    /// the behaviour of a scaffolding that does not override it is unchanged.
+    fn get_flow_counter(&self, isolation_key: u64, tor_dst: &TorAddr) -> Option<Arc<BandwidthCounter>> {
+        let _ = tor_dst;
+        self.get_bandwidth_counter(isolation_key)
+    }
+
     /// Provide configuration for a new UDP tunnel
     ///
     /// Requires the "experimental-udp-tunnel" crate feature.
@@ -428,4 +437,21 @@ mod test {
         #[cfg(feature = "experimental-udp-tunnel")]
         assert_eq!(dummy.udp_prebuild(0), HashMap::new());
     }
+
+    // FreeholdOS patch 0006: the counter of a flow is the counter of its app unless the scaffolding chooses another.
+    #[test]
+    fn the_counter_of_a_flow_defaults_to_the_counter_of_its_app() {
+        struct PerApp(Arc<BandwidthCounter>);
+        impl TunnelScaffolding for PerApp {
+            fn get_bandwidth_counter(&self, _isolation_key: u64) -> Option<Arc<BandwidthCounter>> {
+                Some(self.0.clone())
+            }
+        }
+        let dst = TorAddr::from(("example.com", 443)).unwrap();
+        assert_eq!(DummyScaffolding.get_flow_counter(7, &dst), None, "no counter at all by default");
+        let counter = Arc::new(BandwidthCounter::new());
+        let s = PerApp(counter.clone());
+        let got = s.get_flow_counter(7, &dst).expect("the app's counter");
+        assert!(Arc::ptr_eq(&got, &counter), "the same counter, not a copy");
+    }
 }
